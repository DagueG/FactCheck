# Copie ce fichier en ".env" dans 04_orchestration/ (docker compose le lit automatiquement).
#
# UID utilise par les conteneurs Airflow pour ecrire les fichiers.
# - Windows (Docker Desktop) / macOS : laisse 50000, ca fonctionne.
# - Linux : mets ton UID (resultat de la commande `id -u`) pour eviter les soucis de droits.
AIRFLOW_UID=50000

# (Optionnel) surcharge des libs installees au demarrage du conteneur.
# _PIP_ADDITIONAL_REQUIREMENTS=pandas pyarrow requests python-dotenv
